---
import Layout from '../layouts/Layout.astro';
import { SCREENSAVER_CATALOG } from '../data/screensaver-catalog';
import { getProductByHandle } from '../lib/shopify/client';
import { formatMoney } from '../lib/shopify/format-money';
import AddToCartButton from '../components/shop/AddToCartButton';
import { HeroShaderBackground } from '../components/HeroShaderBackground';
import { DRIPPY_SHADER } from '../shaders/fever-dream-catalog-shaders';

const steps = [
  {
    title: 'Buy it',
    body: 'Click "Add to cart" — each screensaver is $1 — then check out whenever you\'re ready. No account needed.',
  },
  {
    title: 'Open the .saver file',
    body: 'Safari unzips it automatically — find it in your Downloads folder (or the browser\'s download tray) and double-click it. Everything here is signed with a Developer ID certificate and notarized by Apple, so Gatekeeper won\'t show any "unidentified developer" warning.',
  },
  {
    title: 'It installs itself',
    body: 'Double-clicking installs it to ~/Library/Screen Savers and opens System Settings straight to the Screen Saver pane with it already selected.',
  },
];

// Each screensaver's Shopify product handle matches its catalog slug —
// fetched at build time so the page ships variant IDs without a client round trip.
const screensaversWithProducts = await Promise.all(
  SCREENSAVER_CATALOG.map(async (entry) => {
    const product = await getProductByHandle(entry.slug);
    return { entry, product };
  })
);
---

<Layout
  title="Downloads | Ryan Clayton"
  description="Screen savers and other downloadable projects."
  showNavigation={true}
>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden">
    <!-- Hero — full-bleed, product-forward (Dawn-style) -->
    <section class="relative border-b border-white/10 overflow-hidden">
      <div class="absolute inset-0">
        <HeroShaderBackground client:load shaders={[DRIPPY_SHADER]} />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/30"></div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center animate-fade-in">
        <h1 class="text-5xl lg:text-6xl font-light text-white mb-5 tracking-tight">
          Fever Dream Screens
        </h1>
        <p class="text-xl text-gray-300 max-w-xl mx-auto font-light mb-8">
          Nine hypnotic macOS screensavers, ported from old Quartz Composer patches. Signed,
          notarized, and $1 each.
        </p>
        <a
          href="#shop"
          class="inline-flex items-center gap-2 text-sm font-medium text-black bg-white hover:bg-gray-200 rounded-full px-8 py-3 transition-colors"
        >
          Shop screensavers
        </a>
      </div>
    </section>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <div id="shop" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-12 scroll-mt-24">
        {screensaversWithProducts.map(({ entry, product }) => {
          const variant = product?.variants.nodes[0];
          return (
            <div class="bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-xl p-6 border border-white/10 hover:border-white/20 transition-all duration-300">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center">
                  <img
                    src={`/${entry.slug}-icon.png`}
                    alt={`${entry.name} icon`}
                    class="w-12 h-12 rounded-lg"
                    width="48"
                    height="48"
                  />
                  <div class="ml-4">
                    <h3 class="text-lg font-normal text-white">{entry.name}</h3>
                    <p class="text-sm text-gray-400">macOS Screen Saver</p>
                  </div>
                </div>
                {variant && <p class="text-sm font-medium text-white">{formatMoney(variant.price)}</p>}
              </div>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Swift</span>
                <span class="px-2 py-1 bg-white/10 text-gray-300 text-xs rounded">Metal</span>
              </div>
              {variant ? (
                <AddToCartButton client:visible variantId={variant.id} availableForSale={variant.availableForSale} />
              ) : (
                <span class="inline-flex items-center gap-2 text-sm text-gray-500 bg-white/5 border border-white/10 rounded-lg px-3 py-2">
                  Unavailable
                </span>
              )}
            </div>
          );
        })}
      </div>

      <!-- Fever.Dream iOS/Mac/Vision app — secondary mention, not the headline act -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-5 mb-12">
        <img
          src="/fever-dream-app-icon.webp"
          alt="Fever.Dream app icon"
          class="w-14 h-14 rounded-[22%] flex-shrink-0"
          width="56"
          height="56"
        />
        <div class="flex-1 min-w-0">
          <h3 class="text-base font-normal text-white">Also from me: Fever.Dream</h3>
          <p class="text-sm text-gray-400">
            Real-time, audio-reactive camera effects for iPhone, Mac &amp; Apple Vision — free on
            the App Store.
          </p>
        </div>
        <a
          href="https://apps.apple.com/us/app/fever-dream/id6754286952"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-white bg-blue-500 hover:bg-blue-400 rounded-full px-6 py-2 transition-colors flex-shrink-0"
        >
          GET
        </a>
      </div>

      <!-- Install steps -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-xl font-light text-white mb-6">Installing one</h2>
        <ol class="space-y-6">
          {steps.map((step, i) => (
            <li class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-purple-600/40 text-white text-sm flex items-center justify-center font-medium">
                {i + 1}
              </div>
              <div>
                <h3 class="text-white font-normal mb-1">{step.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Trust / verification -->
      <div class="bg-black/60 backdrop-blur-md rounded-2xl border border-white/10 p-8 mb-8">
        <h2 class="text-xl font-light text-white mb-4">Why you can trust these downloads</h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          Everything on this page is built and signed by me, Ryan Clayton, under my own Apple
          Developer ID (Team ID <code class="text-gray-300">AWLLM3Q8GW</code>). Each is also
          notarized: Apple independently scanned the exact binary you're downloading and issued it
          a ticket, which is stapled to the file so Gatekeeper can verify it offline. You don't have
          to take my word for any of that — check it yourself after downloading:
        </p>
        <pre class="bg-black/60 border border-white/10 rounded-lg p-4 text-sm text-gray-300 overflow-x-auto"><code>spctl -a -vv -t install ~/Downloads/&lt;Name&gt;.saver</code></pre>
        <p class="text-gray-400 text-sm leading-relaxed mt-4">
          That should print <code class="text-gray-300">source=Notarized Developer ID</code> and
          <code class="text-gray-300">origin=Developer ID Application: Ryan Clayton (AWLLM3Q8GW)</code>.
          If it doesn't say exactly that, don't run it. The source is also public if you'd rather
          read the code than trust a signature:
        </p>
        <a
          href="https://github.com/feverdreaminteractive/AudioMoire"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-4 text-sm text-gray-400 hover:text-white transition-colors"
        >
          View source on GitHub &rarr;
        </a>
      </div>

      <!-- Photosensitivity warning -->
      <div class="flex items-start gap-2 text-left bg-amber-500/10 border border-amber-500/30 rounded-xl p-4">
        <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        <p class="text-sm text-amber-200/90 leading-relaxed">
          <strong class="font-medium text-amber-100">Photosensitivity warning:</strong> these
          patterns include rapid flashing, strobing, and high-contrast pulsing — especially Bloom, Hypno, and Shatter.
          If you or anyone in your household has photosensitive epilepsy or a seizure disorder, use caution
          or skip these.
        </p>
      </div>

    </div>
  </main>
</Layout>
