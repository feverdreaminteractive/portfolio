---
import Layout from '../layouts/Layout.astro';
import DrumMachine from '../components/DrumMachine/DrumMachine.tsx';
---

<Layout
  title="Drum Machine | Ryan Clayton"
  description="A browser-based step-sequencer drum machine."
  showNavigation={true}
>
  <main class="min-h-screen bg-black pt-24 pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-light text-white mb-2">Drum Machine</h1>
      <p class="text-gray-400 mb-8">A 16-step sequencer, running on the Web Audio API.</p>
      <DrumMachine client:only="react" />
    </div>
  </main>
</Layout>
