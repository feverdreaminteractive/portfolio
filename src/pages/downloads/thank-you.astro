---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Thank you | Ryan Clayton"
  description="Order confirmation for your Fever Dream screensaver purchase."
  showNavigation={true}
>
  <main class="min-h-screen bg-black pt-20 relative overflow-hidden flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-black to-blue-900/20"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>

    <div class="relative max-w-lg mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-purple-600/20 border border-purple-500/30 flex items-center justify-center">
        <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>

      <h1 class="text-3xl lg:text-4xl font-light text-white mb-4">Thanks for your order!</h1>

      <p id="order-number" class="text-gray-400 text-sm mb-6 hidden"></p>

      <p class="text-gray-300 leading-relaxed mb-8">
        Shopify will email you a receipt shortly. We'll follow up separately with your download
        link — if it's been a while and you haven't heard from us, reach out through the
        <a href="/hire-me" class="text-purple-400 hover:text-purple-300 underline">contact page</a>.
      </p>

      <a
        href="/downloads"
        class="inline-flex items-center gap-2 text-sm text-white bg-white/10 hover:bg-white/20 border border-white/10 hover:border-white/20 rounded-lg px-4 py-2 transition-all"
      >
        Back to Downloads
      </a>
    </div>
  </main>
</Layout>

<script>
  import { clearCart } from '../../stores/cart';

  clearCart();

  const params = new URLSearchParams(window.location.search);
  const order = params.get('order');
  if (order) {
    const el = document.getElementById('order-number');
    if (el) {
      el.textContent = `Order #${order}`;
      el.classList.remove('hidden');
    }
  }
</script>
